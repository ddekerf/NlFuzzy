<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NlFuzzy.Samples</RootNamespace>
    <AssemblyName>NlFuzzy.Sample.Console</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- CA1303: the sample prints Dutch prose; localizing it would obscure the example. -->
    <NoWarn>$(NoWarn);CA1303;CA1515;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NlFuzzy\NlFuzzy.csproj" />
  </ItemGroup>

</Project>
